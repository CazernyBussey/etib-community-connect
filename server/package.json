{
  "name": "etib-community-connect",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "create-admin": "node create-admin.js",
    "check": "node --check server.js && node --check create-admin.js && node --check listing-edit-routes.js && node --check ../public/script.js",
    "check:html": "html-validate ../public/*.html",
    "test": "npm run check && npm run check:html && node --test test/*.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "html-validate": "^11.6.0"
  }
}
